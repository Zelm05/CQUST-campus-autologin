# 签名密钥与密码（含敏感信息，禁止提交）
*.keystore
*.jks
keystore.properties
keystore*.properties

# 构建产物
/build
/.gradle
**/build/
/local.properties
*.apk
*.aab
captures/
.externalNativeBuild/
.DS_Store

# Python / 桌面版
__pycache__/
*.pyc
# 桌面版打包配置保留（spec/icon/setup.iss），仅排除 PyInstaller 中间产物
!windows/source/build/
windows/source/build/stage/
windows/source/build/dist/
windows/source/build/work/
# Inno Setup 输出目录
windows/source/output/

# Windows 运行期生成文件（本地账号/日志/状态，禁止提交）
windows/source/config.json
windows/source/boot_task.json
windows/source/daemon.pid
windows/source/status.json
windows/source/logs/

# 发布物（APK / 安装包走 GitHub Releases，不进仓库）
release/*.apk
release/*.aab
release/*.exe
release/*.zip
windows/*.exe
windows/*.zip
